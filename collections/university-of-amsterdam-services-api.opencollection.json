              {
                "name": "account",
                "value": "",
                "type": "path",
                "description": "Account name (user or group)"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "path",
                "description": "Dataset name"
              },
              {
                "name": "serviceName",
                "value": "",
                "type": "path",
                "description": "Service name"
              }
