{
  "opencollection": "1.0.0",
  "info": {
    "name": "TriplyDB Accounts Services API",
    "version": "26.5.104"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Services",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List services",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lod.uba.uva.nl/datasets/:account/:dataset/services",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path",
                "description": "Account name (user or group)"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "path",
                "description": "Dataset name"
              }
            ]
          },
          "docs": "List services"
        },
        {
          "info": {
            "name": "Create a service",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.lod.uba.uva.nl/datasets/:account/:dataset/services",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path",
                "description": "Account name (user or group)"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "path",
                "description": "Dataset name"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
