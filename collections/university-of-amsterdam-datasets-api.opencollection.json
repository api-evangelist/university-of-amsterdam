{
  "opencollection": "1.0.0",
  "info": {
    "name": "TriplyDB Accounts Datasets API",
    "version": "26.5.104"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Datasets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all datasets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lod.uba.uva.nl/datasets",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Search term"
              },
              {
                "name": "since",
                "value": "",
                "type": "query",
                "description": "Cursor for pagination. Should be provided using the `link` header"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results"
              },
              {
                "name": "sparql",
                "value": "",
                "type": "query",
                "description": "Filter datasets with active SPARQL service"
              },
              {
                "name": "verbose",
                "value": "",
                "type": "query",
                "description": "Return verbose dataset information"
              },
              {
                "name": "sortDirection",
                "value": "",
                "type": "query",
                "description": "Sort direction"
              }
            ]
          },
          "docs": "List all datasets"
        },
        {
          "info": {
            "name": "List datasets for an account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lod.uba.uva.nl/datasets/:account",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path",
                "description": "Account name (user or group)"
              },
              {
                "name": "q",
                "value": "",
                "type": "query"
              },
              {
                "name": "since",
                "value": "",
                "type": "query",
                "description": "Cursor for pagination. Should be provided using the `link` header"
              },
              {
                "name": "accessLevel",
                "value": "",
                "type": "query"
              },
              {
                "name": "sortBy",
                "value": "",
                "type": "query"
              },
              {
                "name": "sortDirection",
                "value": "",
                "type": "query",
                "description": "Sort direction"
              }
            ]
          },
          "docs": "List datasets for an account"
        },
        {
          "info": {
            "name": "Create a dataset",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.lod.uba.uva.nl/datasets/:account",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path",
                "description": "Account name (user or group)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a dataset"
        },
        {
          "info": {
            "name": "Get dataset details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lod.uba.uva.nl/datasets/:account/:dataset",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path",
                "description": "Account name (user or group)"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "path",
                "description": "Dataset name"
              },
              {
                "name": "verbose",
                "value": "",
                "type": "query",
                "description": "Include services, graphs, and jobs"
              }
            ]
          },
          "docs": "Get dataset details"
        },
        {
          "info": {
            "name": "Update a dataset",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.lod.uba.uva.nl/datasets/:account/:dataset",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path",
                "description": "Account name (user or group)"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "path",
                "description": "Dataset name"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a dataset"
        },
        {
          "info": {
            "name": "Delete a dataset",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.lod.uba.uva.nl/datasets/:account/:dataset",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path",
                "description": "Account name (user or group)"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "path",
                "description": "Dataset name"
              }
            ]
          },
          "docs": "Delete a dataset"
        },
        {
          "info": {
            "name": "Copy a dataset",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.lod.uba.uva.nl/datasets/:account/:dataset/copy",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path",
                "description": "Account name (user or group)"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "path",
                "description": "Dataset name"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Copy a dataset"
        },
        {
          "info": {
            "name": "Transfer dataset ownership",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.lod.uba.uva.nl/datasets/:account/:dataset/chown",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path",
                "description": "Account name (user or group)"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "path",
                "description": "Dataset name"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Transfer dataset ownership"
        },
        {
          "info": {
            "name": "Download dataset as RDF",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lod.uba.uva.nl/datasets/:account/:dataset/download",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path",
                "description": "Account name (user or group)"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "path",
                "description": "Dataset name"
              },
              {
                "name": "graph",
                "value": "",
                "type": "query",
                "description": "Filter to a specific graph IRI"
              }
            ]
          },
          "docs": "Download dataset as RDF"
        },
        {
          "info": {
            "name": "Check dataset download headers",
            "type": "http"
          },
          "http": {
            "method": "HEAD",
            "url": "https://api.lod.uba.uva.nl/datasets/:account/:dataset/download",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path",
                "description": "Account name (user or group)"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "path",
                "description": "Dataset name"
              },
              {
                "name": "graph",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Check dataset download headers"
        }
      ]
    }
  ],
  "bundled": true
}