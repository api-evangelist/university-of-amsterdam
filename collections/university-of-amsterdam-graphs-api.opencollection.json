{
  "opencollection": "1.0.0",
  "info": {
    "name": "TriplyDB Accounts Graphs API",
    "version": "26.5.104"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Graphs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List graphs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lod.uba.uva.nl/datasets/:account/:dataset/graphs",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path",
                "description": "Account name (user or group)"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "path",
                "description": "Dataset name"
              },
              {
                "name": "since",
                "value": "",
                "type": "query",
                "description": "Cursor for pagination. Should be provided using the `link` header"
              },
              {
                "name": "sortBy",
                "value": "",
                "type": "query"
              },
              {
                "name": "sortDirection",
                "value": "",
                "type": "query",
                "description": "Sort direction"
              }
            ]
          },
          "docs": "List graphs"
        },
        {
          "info": {
            "name": "Delete all graphs",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.lod.uba.uva.nl/datasets/:account/:dataset/graphs",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path",
                "description": "Account name (user or group)"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "path",
                "description": "Dataset name"
              }
            ]
          },
          "docs": "Delete all graphs"
        },
        {
          "info": {
            "name": "Get graph details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lod.uba.uva.nl/datasets/:account/:dataset/graphs/:graphId",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path",
                "description": "Account name (user or group)"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "path",
                "description": "Dataset name"
              },
              {
                "name": "graphId",
                "value": "",
                "type": "path",
                "description": "Graph identifier"
              }
            ]
          },
          "docs": "Get graph details"
        },
        {
          "info": {
            "name": "Rename a graph",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.lod.uba.uva.nl/datasets/:account/:dataset/graphs/:graphId",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path",
                "description": "Account name (user or group)"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "path",
                "description": "Dataset name"
              },
              {
                "name": "graphId",
                "value": "",
                "type": "path",
                "description": "Graph identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Rename a graph"
        },
        {
          "info": {
            "name": "Delete a graph",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.lod.uba.uva.nl/datasets/:account/:dataset/graphs/:graphId",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path",
                "description": "Account name (user or group)"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "path",
                "description": "Dataset name"
              },
              {
                "name": "graphId",
                "value": "",
                "type": "path",
                "description": "Graph identifier"
              }
            ]
          },
          "docs": "Delete a graph"
        },
        {
          "info": {
            "name": "Get graph import configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lod.uba.uva.nl/datasets/:account/:dataset/imports",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path",
                "description": "Account name (user or group)"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "path",
                "description": "Dataset name"
              }
            ]
          },
          "docs": "Get graph import configuration"
        },
        {
          "info": {
            "name": "Update graph import configuration",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.lod.uba.uva.nl/datasets/:account/:dataset/imports",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path",
                "description": "Account name (user or group)"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "path",
                "description": "Dataset name"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update graph import configuration"
        }
      ]
    }
  ],
  "bundled": true
}